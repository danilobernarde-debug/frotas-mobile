# Mesmo projeto Supabase do frotas-web -- copie os valores de
# frotas-web/.env.local (NEXT_PUBLIC_SUPABASE_URL / _ANON_KEY).
EXPO_PUBLIC_SUPABASE_URL=https://seuprojeto.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=a_chave_anon_public

# URL pública do frotas-web publicado (rota /api/mobile/anexos vive lá).
# Em desenvolvimento local, aponte para o `npm run dev` do frotas-web.
EXPO_PUBLIC_APP_URL=http://localhost:3000
