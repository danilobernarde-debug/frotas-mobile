{
  "expo": {
    "name": "frotas-mobile",
    "slug": "frotas-mobile",
    "version": "1.0.0",
    "scheme": "frotas-mobile",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "experiments": {
      "typedRoutes": true
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dbmachado.frotas",
      "infoPlist": {
        "NSCameraUsageDescription": "Usado para fotografar o problema, a bomba, a placa ou o KM na solicitação.",
        "NSLocationWhenInUseUsageDescription": "Usado para registrar onde a foto do abastecimento foi tirada."
      }
    },
    "android": {
      "package": "com.dbmachado.frotas",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Usado para fotografar o problema, a bomba, a placa ou o KM na solicitação."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Usado para fotografar o problema, a bomba, a placa ou o KM na solicitação.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Usado para registrar onde a foto do abastecimento foi tirada."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Usado para gravar um áudio e mandar na conversa com a gestão de frotas."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0d9488"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "54b551bc-e39d-49ca-bee8-7c9a9315008f"
      }
    },
    "owner": "danilobernardes",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/54b551bc-e39d-49ca-bee8-7c9a9315008f"
    }
  }
}
