# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# Firebase -- chave de conta de serviço (segredo, nunca commitar);
# google-services.json fica de fora do ignore de propósito (não é
# segredo, é referenciado em app.json/android.googleServicesFile e
# precisa estar no repo pro build funcionar).
Firebase/*firebase-adminsdk*.json

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
